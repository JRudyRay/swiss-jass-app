{
  "name": "swiss-jass-web",
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://JRudyRay.github.io/swiss-jass-app",
  "scripts": {
    "dev": "vite",
    "sim": "ts-node scripts/simulate.ts",
    "build-smoke-unit": "npx esbuild scripts/unit_tests.ts --bundle --platform=node --format=cjs --outfile=dist_scripts/unit_tests.bundle.cjs --sourcemap",
    "build-smoke-sim": "npx esbuild scripts/simulate.ts --bundle --platform=node --format=cjs --outfile=dist_scripts/simulate.bundle.cjs --sourcemap",
    "build-h2h": "npx esbuild scripts/h2h.ts --bundle --platform=node --format=cjs --outfile=dist_scripts/h2h.bundle.cjs --sourcemap",
    "h2h": "npm run build-h2h && node dist_scripts/h2h.bundle.cjs",
    "build-smoke": "npm run build-smoke-unit && npm run build-smoke-sim",
    "smoke": "npm run build-smoke && node dist_scripts/unit_tests.bundle.cjs && node dist_scripts/simulate.bundle.cjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run smoke && npm run build",
    "preview": "vite preview",
    "deploy": "npx gh-pages -d dist",
    "check-cards": "node scripts/check-card-images.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^5.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2"
  }
}
