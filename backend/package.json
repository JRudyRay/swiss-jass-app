{
  "name": "swiss-jass-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "rimraf dist node_modules/.prisma && npx prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && ts-node src/tests/gameEngine.test.ts",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "smoke": "ts-node src/tests/friendAndTable.test.ts",
    "reset:smoke": "ts-node scripts/resetAndSmoke.ts",
    "multi": "ts-node src/tests/multiplayerFlow.test.ts",
    "db:reset": "npx prisma migrate reset --force && npx prisma db push && npx tsx scripts/seed.ts",
    "db:seed": "npx tsx scripts/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.15.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^5.1.7",
    "trueskill": "^0.0.2",
    "ts-trueskill": "^1.0.1",
    "typescript": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/express-validator": "^2.20.33",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.4.0",
    "@types/supertest": "^2.0.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.9.9",
    "rimraf": "^5.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.0",
    "typescript-eslint": "^8.71.1"
  }
}
