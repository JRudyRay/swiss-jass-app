# Database
DATABASE_URL=file:/data/swiss_jass.db

# Server Configuration
NODE_ENV=production
PORT=3000

# JWT Configuration (set these to secure random values)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
# Required to enable DELETE /api/admin/users/:id (sent as x-admin-token); route is off when unset
ADMIN_TOKEN=

# CORS Configuration (optional)
CORS_ORIGIN=*

# Logging (optional)
LOG_LEVEL=info